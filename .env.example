# Copy to .env.local for local development. Never put real values in this file
# — it is committed. Production values live in the Vercel dashboard.

# API URLs
# NOTE: no trailing /api/v1 — the app appends that itself. Setting it here
# produces /api/v1/api/v1/... and every request 404s.
NEXT_PUBLIC_API_URL=http://localhost:3001

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth Configuration
# Create these at https://console.cloud.google.com → APIs & Services →
# Credentials, and add <APP_URL>/api/auth/google/callback as an authorised
# redirect URI.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Razorpay (Optional - configure later)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# Analytics (optional)
NEXT_PUBLIC_GA_TRACKING_ID=

# The single store this site sells for (matches the backend seed).
NEXT_PUBLIC_STORE_VENDOR_ID=00000000-0000-0000-0000-000000000001

# Feature flags
# Lookbook is built and working but hidden from the storefront for now — the
# route 404s and no nav link points at it. Set to "true" to bring it back.
NEXT_PUBLIC_LOOKBOOK_ENABLED=false
